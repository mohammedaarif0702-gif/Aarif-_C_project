#include <stdio.h>

int main() {
    int num, steps = 0;

    printf("Enter a positive integer: ");
    scanf("%d", &num);

    while (num > 0) {
        if (num % 2 == 0) {
            num = num / 2;
        } else {
            num = num - 1;
        }

        steps++;
    }

    printf("Number of steps = %d\n", steps);

    return 0;
}
